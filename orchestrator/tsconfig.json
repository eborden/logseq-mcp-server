// Type-checks the orchestrator only. It is separate from the root tsconfig.json on purpose (parent plan #625):
// Temporal's dependencies stay out of the root tooling. Run with `npm run typecheck` inside orchestrator/.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": ".",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", ".temporal"]
}
