# The constants of the mutation workflows (ADR-0033 "The budget"). rust-mutation.yml and rust-mutation-full.yml copy the
# KEY=VALUE lines into their environment, so the PR job and a proof run plan with the same numbers, and a test
# (rust/mutation-ratchet/tests/limits_file.rs) holds MUTANT_BUDGET to the arithmetic below and the workflow timeouts to
# JOB_TIMEOUT_MINUTES. Only KEY=VALUE lines and comments are allowed here.
#
# From the CI calibration of #364 PR 1 (a one-in-100 sample, 27 mutants of about 2,700, on the ubuntu-latest runner): with
# incremental builds a mutant took 12 s on average, 18 s at the 90th percentile and 48 s at most, against 23 s, 29 s and 60 s
# without; --jobs 2 was no faster than --jobs 1 (about 12.5 s per mutant of wall time either way) and made each mutant slower
# and more variable (mean 25 s, slowest 87 s). The unmutated baseline took about 90 s (build 50 s, test 38 s) per call.

# The cargo-mutants version the workflows install, exact (ADR-0033 "Tool and scope"). An upgrade can change the mutator set and so
# every score, so it is its own PR and it re-baselines. The name has no CARGO_ prefix on purpose: Swatinem/rust-cache hashes every
# CARGO* variable into its key, and the mutation workflows must compute the build job's key to restore its cache.
MUTANTS_TOOL_VERSION=27.1.0

# The PR job's timeout-minutes (repeated as a literal in rust-mutation.yml, which a test holds equal to this).
JOB_TIMEOUT_MINUTES=20

# Seconds before the first mutant: job setup, the tool's install (from its cache) and the plan package's tests and build
# (about 30 s together), and the baseline build and test the tool always runs first (about 95 s), for each of the two
# `cargo mutants` calls a mixed plan makes (one by changed lines, one by whole file).
OVERHEAD_SECONDS=250

# Seconds kept unused, for the job's own steps (plan, report, upload) and run-to-run noise.
SPARE_SECONDS=120

# The slowest measured seconds per mutant, rounded up from the 90th percentile of 18 s (a mutant the tests miss runs the whole
# 38 s test suite, and the sample had one such mutant of 27, so the full run will tell if this is low).
SECONDS_PER_MUTANT=20

# `cargo mutants --jobs`. At most 2 (ADR-0033 "Quiet by construction"). 1, because 2 gave no speed-up and more variance: the
# build and the tests already use every core, and the crate's integration tests bind a local port for a stub LogSeq.
MUTANT_JOBS=1

# Mutants the PR job may take, the re-run reserve (the largest selected file, counted twice in the plan) included:
#   (JOB_TIMEOUT_MINUTES * 60 - OVERHEAD_SECONDS - SPARE_SECONDS) * MUTANT_JOBS / SECONDS_PER_MUTANT
#   = (1200 - 250 - 120) * 1 / 20 = 41
MUTANT_BUDGET=41

# How many chained jobs one full run is split into, whole files balanced by mutant count. One mutant is 12 s at --jobs 1, so
# about 2,700 mutants are about 9 hours: two slices of about 4.5 hours fit the 6 hour job limit.
FULL_RUN_SLICES=2
