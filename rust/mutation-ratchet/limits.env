# The constants of the mutation workflows (ADR-0033 "The budget"). rust-mutation.yml and rust-mutation-full.yml copy the
# KEY=VALUE lines into their environment, so the PR job and a proof run plan with the same numbers, and a test
# (rust/mutation-ratchet/tests/limits_file.rs) holds MUTANT_BUDGET to the arithmetic below and the workflow timeouts to
# JOB_TIMEOUT_MINUTES. Only KEY=VALUE lines and comments are allowed here.
#
# PROVISIONAL until the CI measurements of #364 PR 1 replace them. The seconds per mutant, the overhead and the choice of
# 2 jobs are the ADR's assumptions (20 s a mutant by the Rust job's step timings, a few minutes of install, restore and
# baseline), not measurements.

# The PR job's timeout-minutes (repeated as a literal in rust-mutation.yml, which a test holds equal to this).
JOB_TIMEOUT_MINUTES=20

# Seconds before the first mutant: the tool's install (from its cache), the dependency restore, and the baseline build and test
# the tool always runs first, for each of the two `cargo mutants` calls a mixed plan makes (one by changed lines, one by
# whole file).
OVERHEAD_SECONDS=300

# Seconds kept unused, for the job's own steps (plan, report, upload) and run-to-run noise.
SPARE_SECONDS=120

# The slowest measured seconds per mutant (a rebuild and a test run, at MUTANT_JOBS in flight).
SECONDS_PER_MUTANT=20

# `cargo mutants --jobs`. At most 2 (ADR-0033 "Quiet by construction"): each job has its own target directory and the crate's
# integration tests bind a local port for a stub LogSeq.
MUTANT_JOBS=2

# Mutants the PR job may take, the re-run reserve (the largest selected file, counted twice in the plan) included:
#   (JOB_TIMEOUT_MINUTES * 60 - OVERHEAD_SECONDS - SPARE_SECONDS) * MUTANT_JOBS / SECONDS_PER_MUTANT
#   = (1200 - 300 - 120) * 2 / 20 = 78
MUTANT_BUDGET=78

# How many chained jobs one full run is split into, whole files balanced by mutant count.
FULL_RUN_SLICES=1
