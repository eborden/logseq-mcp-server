{"group":"get-graph-info","cases":[
  {"name":"graph info","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":{"url":"logseq_local_/tmp/example-graph","name":"example-graph","path":"/tmp/example-graph"}}]],"expected":{"content":[{"type":"text","text":"{\"url\":\"logseq_local_/tmp/example-graph\",\"name\":\"example-graph\",\"path\":\"/tmp/example-graph\"}"}]}},
  {"name":"graph info with extra keys","tool":"logseq_get_graph_info","arguments":{"ignored":true},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":{"7":"seven","path":"/tmp/example-graph","extra":{"nested":[1,2.5,null]},"name":"example-graph"}}]],"expected":{"content":[{"type":"text","text":"{\"7\":\"seven\",\"path\":\"/tmp/example-graph\",\"extra\":{\"nested\":[1,2.5,null]},\"name\":\"example-graph\"}"}]}},
  {"name":"graph info with no fields","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":{}}]],"expected":{"content":[{"type":"text","text":"{}"}]}},
  {"name":"no graph open","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":null}]],"expected":{"content":[{"type":"text","text":"{\"error\":\"Failed to retrieve graph information\"}"}],"isError":true}},
  {"name":"graph info with a name that is not text is passed through","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":{"name":3}}]],"expected":{"content":[{"type":"text","text":"{\"name\":3}"}]}},
  {"name":"graph info that is not an object","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":[]}]],"expected":{"content":[{"type":"text","text":"{\"error\":\"LogSeq answered logseq.App.getCurrentGraph in a shape this server can't read: answer: expected an object, got a list\\n\\nSteps to fix:\\n1. Check which LogSeq version is running. This server is tested against LogSeq 0.10.x, and a different version may name or type fields differently\\n2. If the version is right, report this on the project's GitHub issues with the method name and the path above (leave out page names and block text)\"}"}],"isError":true}},
  {"name":"LogSeq error for the graph","tool":"logseq_get_graph_info","arguments":{},"steps":[[{"method":"logseq.App.getCurrentGraph","args":[],"response":{"error":"MethodNotExist: logseq.App.getCurrentGraph"}}]],"expected":{"content":[{"type":"text","text":"{\"error\":\"LogSeq API error: MethodNotExist: logseq.App.getCurrentGraph\"}"}],"isError":true}}
]}
