{
  "name": "logseq-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that gives Claude read-only access to a LogSeq knowledge graph: context building, search, graph traversal and journal date ranges.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tests/integration/tsconfig.json",
    "test": "vitest run tests/guards && vitest run tests/rust-guards && npm run test:integration",
    "test:guards": "vitest run tests/guards",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "logseq",
    "knowledge-graph",
    "pkm",
    "notes",
    "claude"
  ],
  "author": "Evan Rutledge Borden (https://github.com/eborden)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eborden/logseq-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/eborden/logseq-mcp-server/issues"
  },
  "homepage": "https://github.com/eborden/logseq-mcp-server#readme",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "3.25.76"
  }
}
