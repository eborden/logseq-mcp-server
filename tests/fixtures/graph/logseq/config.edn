;; Config for the logseq-mcp-server integration-test fixture graph (#86, #87).
;; LogSeq merges this over its built-in defaults and the user's global config, so
;; only settings that change how files are parsed or pages are named are pinned here.
;; Repo config wins over global config, which keeps parsing the same on every machine.
{:meta/version 1

 ;; Files are markdown, under pages/ and journals/.
 :preferred-format :markdown
 :pages-directory "pages"
 :journals-directory "journals"
 :feature/enable-journals? true

 ;; Journal file names (journals/2025_01_01.md) and page titles (Jan 1st, 2025).
 :journal/file-name-format "yyyy_MM_dd"
 :journal/page-title-format "MMM do, yyyy"

 ;; Namespaced page files use "___" for "/" (pages/project atlas___notes.md).
 :file/name-format :triple-lowbar

 ;; Property values like [[x]] create pages, as in a default graph.
 :property-pages/enabled? true
 :property-pages/excludelist #{}

 ;; Property values: only [[x]] and #x are page refs, except for the properties
 ;; listed here, whose comma-separated values each become a page ref (reviewers:: Alice, Bob).
 ;; The fixture's multi-value cases depend on this, so a global config can't change it.
 ;; LogSeq 0.10 has no :rich-property-values? or :ref/linkable-journals? setting;
 ;; journal links in property values ([[Jan 15th, 2025]]) are page refs as written.
 :property/separated-by-commas #{:reviewers}
 :ignored-page-references-keywords #{}

 ;; The fixture README describes the folder; it is not a page of the graph.
 :hidden ["/README.md"]}
