// Type-checks the repo's TypeScript tooling: scripts/ (the parity harness, the measure and probe scripts, the
// per-worktree LogSeq instance) and the guard tests (tests/guards). The integration suites have their own
// tests/integration/tsconfig.json. The server itself is Rust (rust/, #356). Run in CI: `npm run typecheck`.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": true,
    "rootDir": ".",
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["scripts/**/*", "tests/**/*.ts", "vitest.config.ts", "vitest.integration.config.ts"],
  // .logseq-instance holds a copy of the fixture graph and the instance's profile, never code.
  "exclude": ["node_modules", "tests/integration/**", "**/.logseq-instance/**"]
}
