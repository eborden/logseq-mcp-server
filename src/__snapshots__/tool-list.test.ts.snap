exports[`tools/list guardrails > matches the tool list snapshot 1`] = `
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Build Context",
    },
    "description": "Everything on one topic in a call: the page's blocks, related pages, and linked references.

**Use when:** researching or explaining a topic that has a page.
**Can't find:** topics with no page (use logseq_search_blocks), or anything past the caps (see hasMore and warnings).
**Alternatives:** logseq_get_page (content only), logseq_get_concept_network (structure only).",
    "inputSchema": {
      "properties": {
        "compact": {
          "default": false,
          "description": "Block snippets and uuids, no bodies. Read one with logseq_get_block",
          "type": "boolean",
        },
        "format": {
          "description": "json (default), or markdown text. Markdown has block uuids only on search hits and with compact",
          "enum": [
            "json",
            "markdown",
          ],
          "type": "string",
        },
        "include_temporal_context": {
          "default": true,
          "description": "Include temporal context for journal pages (default: true)",
          "type": "boolean",
        },
        "max_blocks": {
          "default": 50,
          "description": "Maximum number of blocks to include (default: 50)",
          "type": "number",
        },
        "max_references": {
          "default": 20,
          "description": "Maximum number of reference blocks to include (default: 20)",
          "type": "number",
        },
        "max_related_pages": {
          "default": 10,
          "description": "Maximum number of related pages to include (default: 10)",
          "type": "number",
        },
        "resolve_refs": {
          "default": false,
          "description": "Add resolvedContent/resolvedRefs for ((uuid)) refs and {{embed}}s (depth 2)",
          "type": "boolean",
        },
        "topic_name": {
          "description": "Topic to build context for (page name, alias or ISO date)",
          "type": "string",
        },
      },
      "required": [
        "topic_name",
      ],
      "type": "object",
    },
    "name": "logseq_build_context",
    "title": "Build Context",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Check Links",
    },
    "description": "Check a [[link]] pass. ok is true only if after strips back to before, brackets balance and don't nest, every ref in before is kept, and each [[term]] names exactly one page or alias.

**Can't find:** a link to the wrong page, or a name split across a ref.",
    "inputSchema": {
      "properties": {
        "after": {
          "description": "before plus [[links]], at most 500 distinct terms",
          "maxLength": 50000,
          "type": "string",
        },
        "before": {
          "description": "Text before linking",
          "maxLength": 50000,
          "type": "string",
        },
      },
      "required": [
        "before",
        "after",
      ],
      "type": "object",
    },
    "name": "logseq_check_links",
    "title": "Check Links",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Backlinks",
    },
    "description": "List the pages and blocks that link to a page with [[page]] or #tag.

**Use when:** "what links to X?" or "where is X used?"
**Can't find:** plain-text mentions with no link (logseq_search_blocks) or outbound links (logseq_get_concept_network).
**Alternatives:** logseq_build_context for the page plus related pages.",
    "inputSchema": {
      "properties": {
        "page_name": {
          "description": "Page to get backlinks for (name, alias or ISO date)",
          "type": "string",
        },
      },
      "required": [
        "page_name",
      ],
      "type": "object",
    },
    "name": "logseq_get_backlinks",
    "title": "Get Backlinks",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Block",
    },
    "description": "Get one block by UUID, optionally with its children. UUIDs come from other results and from ((uuid)) refs in content.

**Can't find:** blocks by text (logseq_search_blocks) or by numeric id. For a whole page use logseq_get_page.",
    "inputSchema": {
      "properties": {
        "block_uuid": {
          "description": "UUID of the block to retrieve",
          "type": "string",
        },
        "format": {
          "description": "json (default), or markdown text. Markdown has block uuids only on search hits and with compact",
          "enum": [
            "json",
            "markdown",
          ],
          "type": "string",
        },
        "include_children": {
          "default": false,
          "description": "Whether to include child blocks",
          "type": "boolean",
        },
        "resolve_refs": {
          "default": false,
