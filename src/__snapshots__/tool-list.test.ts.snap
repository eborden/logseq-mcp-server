          "type": "boolean",
        },
      },
      "required": [
        "block_uuid",
      ],
      "type": "object",
    },
    "name": "logseq_get_block",
    "title": "Get Block",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Concept Evolution",
    },
    "description": "Track a concept over time: blocks on its page and blocks linking to it, grouped by day, week or month, with optional date bounds.

**Use when:** "how has X evolved?" or "what's the history of Y?"
**Can't find:** plain-text mentions with no link (logseq_search_blocks), or topics with no page.
**Alternatives:** logseq_query_by_date_range for plain journal queries.",
    "inputSchema": {
      "properties": {
        "concept_name": {
          "description": "Concept to track (page name, alias or ISO date)",
          "type": "string",
        },
        "end_date": {
          "description": "Optional end date in YYYYMMDD format",
          "type": "number",
        },
        "group_by": {
          "description": "Optional grouping period",
          "enum": [
            "day",
            "week",
            "month",
          ],
          "type": "string",
        },
        "start_date": {
          "description": "Optional start date in YYYYMMDD format",
          "type": "number",
        },
      },
      "required": [
        "concept_name",
      ],
      "type": "object",
    },
    "name": "logseq_get_concept_evolution",
    "title": "Get Concept Evolution",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Concept Network",
    },
    "description": "Map pages linked to a concept as nodes and edges, in both link directions, up to max_depth hops. One edge per page pair, with a reference count.

**Caps:** 50 pages, 15 new per page; journal pages are shown but not expanded. If truncated is true, raise max_nodes/max_fanout or set expand_journals.
**Can't find:** unlinked pages, or what pages say (logseq_build_context).",
    "inputSchema": {
      "properties": {
        "concept_name": {
          "description": "Root concept (page name, alias or ISO date)",
          "type": "string",
        },
        "expand_journals": {
          "default": false,
          "description": "Expand through journal pages instead of treating them as leaves (default: false). Journal pages link to almost everything, so this can flood the network.",
          "type": "boolean",
        },
        "format": {
          "description": "json (default), or markdown text. Markdown has block uuids only on search hits and with compact",
          "enum": [
            "json",
            "markdown",
          ],
          "type": "string",
        },
        "max_depth": {
          "default": 2,
          "description": "Maximum depth to traverse (default: 2, max: 3)",
          "type": "number",
        },
        "max_fanout": {
          "default": 15,
          "description": "Maximum new pages any one page may add (default: 15, max: 100)",
          "type": "number",
        },
        "max_nodes": {
          "default": 50,
          "description": "Maximum pages in the network, root included (default: 50, max: 500)",
          "type": "number",
        },
      },
      "required": [
        "concept_name",
      ],
      "type": "object",
    },
    "name": "logseq_get_concept_network",
    "title": "Get Concept Network",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Context for Query",
    },
    "description": "Context for a natural-language question. Takes [[page]] and #tag topics from the query, else searches its first 3 words over 3 letters (max 100 hits), and builds context for each.

**Can't find:** meaning, or over 100 keyword hits (put specific words first). Topics come from links, tags or literal words, so put page names in [[brackets]].
**Alternatives:** logseq_build_context for one known topic.",
    "inputSchema": {
      "properties": {
        "compact": {
          "default": false,
          "description": "Block snippets and uuids, no bodies. Read one with logseq_get_block",
          "type": "boolean",
        },
        "format": {
          "description": "json (default), or markdown text. Markdown has block uuids only on search hits and with compact",
          "enum": [
            "json",
            "markdown",
          ],
          "type": "string",
        },
        "max_search_results": {
          "default": 20,
          "description": "Maximum number of search results for queries without explicit topics (default: 20, max: 100)",
          "type": "number",
        },
        "max_topics": {
          "default": 5,
          "description": "Maximum number of topics to extract context for (default: 5)",
          "type": "number",
        },
        "query": {
          "description": "Natural language query (can include [[page references]] and #tags)",
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "logseq_get_context_for_query",
    "title": "Get Context for Query",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Get Current Context",
    },
    "description": "Get what the user is looking at in LogSeq right now: the open page, the block being edited, and any selected blocks.

**Use when:** the user says "this page", "this block" or "what I'm looking at" without naming it. Then pass the page name to logseq_build_context or logseq_get_page.

**Can't find:** anything not open right now. Returns page: null with a message when no page is open.",
    "inputSchema": {
      "properties": {},
      "required": [],
      "type": "object",
    },
    "name": "logseq_get_current_context",
    "title": "Get Current Context",
  },
  {
