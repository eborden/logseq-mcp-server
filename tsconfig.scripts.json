// Type-checks scripts/ and the tests listed below, which tsconfig.json leaves out
// (rootDir: src, and *.test.ts excluded). Run in CI: npx tsc -p tsconfig.scripts.json
// Add a test file here once it type-checks; the rest of src/**/*.test.ts has known errors (#104).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["scripts/**/*", "src/docs-format.test.ts"],
  "exclude": ["node_modules", "dist"]
}
